# Copy this file to scripts/database/database-migration.env and set values locally.
# Never commit the copied file. Do not paste passwords into chat or CI logs.

# direct: local pg_dump/psql use LOCAL_DATABASE_URL (preferred for macOS services)
# docker: Docker Compose service uses LOCAL_POSTGRES_SERVICE and credentials below
LOCAL_DATABASE_MODE=direct
LOCAL_DATABASE_URL=postgresql://<local-user>:<local-password>@127.0.0.1:5432/<local-database>
LOCAL_POSTGRES_SERVICE=postgres
LOCAL_DATABASE_NAME=<local-database>
LOCAL_DATABASE_USER=<local-user>
LOCAL_COMPOSE_FILE=

# SSH identity should normally be configured in ~/.ssh/config or ssh-agent.
REMOTE_SSH_HOST=vmi3446054.contaboserver.net
REMOTE_SSH_USER=<remote-ssh-user>
REMOTE_SSH_PORT=22
REMOTE_APP_DIR=<remote-compose-directory>
REMOTE_COMPOSE_FILE=
REMOTE_POSTGRES_SERVICE=<remote-postgres-service>
REMOTE_BACKEND_SERVICE=<remote-backend-service>
REMOTE_DATABASE_NAME=<remote-database>
REMOTE_DATABASE_USER=<remote-database-user>
REMOTE_BACKUP_DIR=<remote-backup-directory>
REMOTE_STAGING_DIR=<remote-staging-directory>
REMOTE_STAGED_DUMP_PATH=<remote-staging-directory>/<dump-file-name>.dump

# Optional endpoint checked after a successful import.
REMOTE_HEALTH_URL=

# The import and rollback scripts require an outage to be explicitly allowed.
ALLOW_BACKEND_DOWNTIME=false

# Keep generated files outside the repository history.
MIGRATION_ARTIFACT_DIR=database-migration-artifacts
