# Docker Compose template. Copy to backend/.env with restrictive permissions.
# Replace every CHANGE_ME value on the target host; never commit the copied file.
APP_NAME="Rainbow Fashions Inventory"
APP_ENV=production
DEBUG=false
POSTGRES_DB=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=CHANGE_ME
CORS_ORIGINS=http://CHANGE_ME
UPLOAD_DIR=app/uploads
INVOICE_UPLOAD_DIR=app/uploads/invoices
PRODUCT_UPLOAD_DIR=app/uploads/products
OPENING_STOCK_IMPORT_DIR=app/runtime/opening-stock-imports
MAX_OPENING_STOCK_IMPORT_SIZE_MB=25
MAX_OPENING_STOCK_IMPORT_ROWS=20000
ALLOW_TEST_OPENING_STOCK_IMPORT_BYPASS=false
BACKUP_STATUS_DIR=/backup-status
MAX_UPLOAD_SIZE_MB=15
LOG_LEVEL=INFO
