# Docker Compose environment template. Copy to backend/.env and replace every
# change-me value before starting a real environment.
APP_NAME="Rainbow Fashions Inventory"
APP_ENV=production
DEBUG=false

POSTGRES_DB=inventory_db
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=change-me-local-password
DATABASE_URL=postgresql+psycopg://inventory_user:change-me-local-password@postgres:5432/inventory_db

JWT_SECRET_KEY=change-me-random-secret-before-production-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost,http://localhost:5173
UPLOAD_DIR=app/uploads
INVOICE_UPLOAD_DIR=app/uploads/invoices
PRODUCT_UPLOAD_DIR=app/uploads/products
OPENING_STOCK_IMPORT_DIR=app/runtime/opening-stock-imports
MAX_OPENING_STOCK_IMPORT_SIZE_MB=25
MAX_OPENING_STOCK_IMPORT_ROWS=20000
ALLOW_TEST_OPENING_STOCK_IMPORT_BYPASS=false
BACKUP_STATUS_DIR=/backup-status
MAX_UPLOAD_SIZE_MB=15
LOG_LEVEL=INFO
