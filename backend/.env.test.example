# Copy to backend/.env.test for local/UAT use. This file is deliberately ignored.
# Replace every CHANGE_ME value with a testing-only value; never use production values.
APP_NAME="Rainbow Fashions Inventory (UAT)"
APP_ENV=testing
DEBUG=true

POSTGRES_DB=rainbow_inventory_test
POSTGRES_USER=rainbow_test_user
POSTGRES_PASSWORD=CHANGE_ME_TEST_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://rainbow_test_user:CHANGE_ME_TEST_DATABASE_PASSWORD@127.0.0.1:5433/rainbow_inventory_test

JWT_SECRET_KEY=CHANGE_ME_TEST_ONLY_JWT_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DELETE_AUTH_PASSWORD_HASH=

CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
UPLOAD_DIR=app/test_uploads
INVOICE_UPLOAD_DIR=app/test_uploads/invoices
PRODUCT_UPLOAD_DIR=app/test_uploads/products
MAX_UPLOAD_SIZE_MB=15
MAX_PRODUCT_IMAGE_SIZE_MB=5
OCR_PROVIDER=mock
MAX_INVOICE_PAGES=20
LOG_LEVEL=DEBUG

# Used only by backend/scripts/seed_test_data.py. Use a testing-only password.
UAT_TEST_PASSWORD=CHANGE_ME_TEST_USER_PASSWORD
