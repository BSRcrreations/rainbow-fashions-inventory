APP_NAME="Rainbow Fashions Inventory"
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://inventory_user:inventory123@localhost:5432/inventory_db
JWT_SECRET_KEY=replace-this-with-a-long-random-production-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.166:5173,http://192.168.0.110:5173
UPLOAD_DIR=app/uploads
