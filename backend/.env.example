# Local development template. Copy to backend/.env and replace every CHANGE_ME
# value only in your protected local environment. Never commit a real .env file.
APP_NAME="Rainbow Fashions Inventory"
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=CHANGE_ME
CORS_ORIGINS=http://CHANGE_ME
UPLOAD_DIR=app/uploads
INVOICE_UPLOAD_DIR=app/uploads/invoices
PRODUCT_UPLOAD_DIR=app/uploads/products
MAX_UPLOAD_SIZE_MB=CHANGE_ME
OCR_PROVIDER=local
DOCUMENT_AI_PROVIDER=mock
DOCUMENT_AI_FALLBACK_PROVIDER=mock
DOCUMENT_AI_TIMEOUT_SECONDS=CHANGE_ME
DOCUMENT_AI_MAX_RETRIES=CHANGE_ME
DOCUMENT_RETENTION_DAYS=CHANGE_ME
FAILED_UPLOAD_RETENTION_DAYS=CHANGE_ME
LOG_LEVEL=INFO
