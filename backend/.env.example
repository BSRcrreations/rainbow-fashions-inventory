APP_NAME="Rainbow Fashions Inventory"
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://inventory_user:inventory123@localhost:5432/inventory_db
JWT_SECRET_KEY=replace-this-with-a-long-random-production-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.166:5173,http://192.168.0.110:5173
UPLOAD_DIR=app/uploads
INVOICE_UPLOAD_DIR=app/uploads/invoices
PRODUCT_UPLOAD_DIR=app/uploads/products
MAX_UPLOAD_SIZE_MB=15
OCR_PROVIDER=local
DOCUMENT_AI_PROVIDER=mock
DOCUMENT_AI_FALLBACK_PROVIDER=mock
DOCUMENT_AI_TIMEOUT_SECONDS=90
DOCUMENT_AI_MAX_RETRIES=2
DOCUMENT_RETENTION_DAYS=365
FAILED_UPLOAD_RETENTION_DAYS=7
LOG_LEVEL=INFO

# Read-only backup operational status mount. Manual actions are deliberately
# disabled unless a reviewed host-side backup agent is installed.
BACKUP_STATUS_DIR=
BACKUP_RETENTION_DAYS=30
BACKUP_MANUAL_ACTIONS_ENABLED=false
BACKUP_MANUAL_RATE_LIMIT_MINUTES=5
