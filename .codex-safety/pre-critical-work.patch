+diagnose_production_availability:
+  extends: .deploy_local
+  stage: verify
+  image: alpine:3.20
+  needs: []
+  environment:
+    name: production-diagnostics
+  when: manual
+  manual_confirmation: "Run read-only production availability diagnostics?"
+  script:
+    - |
+      set -eu
+      apk add --no-cache bash curl docker-cli docker-cli-compose openssl procps util-linux
+      APP_DIR="$DEPLOY_PATH/current"
+      ARTIFACT_DIR="$CI_PROJECT_DIR/availability-diagnostics"
+      mkdir -p "$ARTIFACT_DIR"
+      test -d "$APP_DIR"
+      cd "$APP_DIR"
+      {
+        echo "== docker compose ps =="
+        docker compose ps || true
+        echo "== container health =="
+        docker inspect -f '{{.Name}} {{if .State.Health}}{{.State.Health.Status}}{{else}}no-healthcheck{{end}}' $(docker compose ps -q) || true
+      } > "$ARTIFACT_DIR/docker.txt" 2>&1
+      {
+        systemctl status docker --no-pager || true
+        systemctl status nginx --no-pager || true
+        systemctl status rainbow-fashions --no-pager || true
+      } > "$ARTIFACT_DIR/systemd.txt" 2>&1
+      ss -lntp > "$ARTIFACT_DIR/listening-sockets.txt" 2>&1 || true
+      {
+        curl --silent --show-error --include --connect-timeout 5 --max-time 15 "$LOCAL_DEPLOY_URL/health/live" || true
+        curl --silent --show-error --include --connect-timeout 5 --max-time 15 "$LOCAL_DEPLOY_URL/health/ready" || true
+        curl --silent --show-error --include --connect-timeout 5 --max-time 15 "$PUBLIC_DEPLOY_URL/health/live" || true
+        curl --silent --show-error --include --connect-timeout 5 --max-time 15 "$PUBLIC_DEPLOY_URL/health/ready" || true
+      } > "$ARTIFACT_DIR/health.txt" 2>&1
+      df -h > "$ARTIFACT_DIR/disk-usage.txt" 2>&1 || true
+      df -ih > "$ARTIFACT_DIR/inode-usage.txt" 2>&1 || true
+      docker system df > "$ARTIFACT_DIR/docker-disk.txt" 2>&1 || true
+      host="${PUBLIC_DEPLOY_URL#https://}"; host="${host%%/*}"
+      echo | openssl s_client -connect "$host:443" -servername "$host" 2>/dev/null | openssl x509 -noout -dates > "$ARTIFACT_DIR/certificate.txt" 2>&1 || true
+      docker compose logs --tail=300 --no-color backend > "$ARTIFACT_DIR/backend.log" 2>&1 || true
+      docker compose logs --tail=300 --no-color frontend > "$ARTIFACT_DIR/frontend.log" 2>&1 || true
+      journalctl -u nginx -n 300 --no-pager > "$ARTIFACT_DIR/nginx-journal.log" 2>&1 || true
+      journalctl -u rainbow-fashions -n 300 --no-pager > "$ARTIFACT_DIR/rainbow-fashions-journal.log" 2>&1 || true
+      ls -la "$DEPLOY_PATH" "$DEPLOY_PATH/releases" > "$ARTIFACT_DIR/releases.txt" 2>&1 || true
+  artifacts:
+    when: always
+    expire_in: 1 day
+    paths:
+      - availability-diagnostics/
+  rules:
+    - if: '$CI_COMMIT_BRANCH == $DEPLOY_BRANCH && $CI_COMMIT_REF_PROTECTED == "true"'
+      when: manual
+    - when: never
+
