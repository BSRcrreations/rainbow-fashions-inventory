[Unit]
Description=Rainbow Fashions Docker Compose application
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/rainbow-fashions/current
ExecStartPre=/usr/bin/test -s /opt/rainbow-fashions/shared/backend.env
ExecStartPre=/usr/bin/test -f /opt/rainbow-fashions/current/docker-compose.yml
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
