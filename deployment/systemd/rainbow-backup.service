[Unit]
Description=Rainbow Fashions daily database and uploads backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=rainbow-backup
Group=rainbow-backup
EnvironmentFile=/etc/rainbow-fashions/backup.env
ExecStart=/opt/rainbow-fashions/current/deployment/scripts/backup_all.sh
Nice=10
IOSchedulingClass=best-effort
NoNewPrivileges=true
PrivateTmp=true
