[Unit]
Description=Rainbow Fashions encrypted offsite database and uploads backup upload
Wants=network-online.target
After=network-online.target rainbow-database-backup.service rainbow-media-backup.service

[Service]
Type=oneshot
User=root
Environment=RAINBOW_APP_ROOT=/opt/rainbow-fashions-prod
Environment=RAINBOW_COMPOSE_PROJECT=rainbow_prod
ExecStart=/opt/rainbow-fashions-prod/current/deployment/scripts/upload_backups_offsite.sh
