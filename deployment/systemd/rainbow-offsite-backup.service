[Unit]
Description=Rainbow Fashions encrypted offsite database and uploads backup upload
Wants=network-online.target
After=network-online.target rainbow-database-backup.service rainbow-media-backup.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/rainbow-fashions/backup.env
ExecStart=/opt/rainbow-fashions/current/deployment/scripts/upload_backups_offsite.sh
