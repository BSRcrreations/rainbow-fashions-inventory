[Unit]
Description=Rainbow Fashions availability health watchdog
After=network-online.target docker.service nginx.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/rainbow-fashions-prod/current
Environment=COMPOSE_PROJECT_NAME=rainbow_prod
Environment=APP_DIR=/opt/rainbow-fashions-prod/current
Environment=STATE_DIR=/opt/rainbow-fashions-prod/monitoring/state
Environment=ALERT_ENV_FILE=/opt/rainbow-fashions-prod/shared/availability-alerts.env
Environment=LOCAL_BASE_URL=http://127.0.0.1:8080
Environment=PUBLIC_BASE_URL=https://rainbow-fashions.in
ExecStart=/opt/rainbow-fashions-prod/current/deployment/scripts/check_application_health.sh
User=root
Group=root
