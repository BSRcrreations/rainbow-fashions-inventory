[Unit]
Description=Rainbow Fashions backup retention review
After=rainbow-offsite-backup.service

[Service]
Type=oneshot
User=root
Environment=RAINBOW_APP_ROOT=/opt/rainbow-fashions
# Dry-run is intentional. Add --execute only after the printed report is reviewed.
ExecStart=/opt/rainbow-fashions/current/deployment/scripts/prune_local_backups.sh
ExecStart=/opt/rainbow-fashions/current/deployment/scripts/prune_offsite_backups.sh
