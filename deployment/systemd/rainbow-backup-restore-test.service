[Unit]
Description=Rainbow Fashions isolated database restore drill
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Environment=RAINBOW_APP_ROOT=/opt/rainbow-fashions-prod
Environment=RAINBOW_COMPOSE_PROJECT=rainbow_prod
ExecStart=/opt/rainbow-fashions-prod/current/deployment/scripts/test_database_restore.sh
