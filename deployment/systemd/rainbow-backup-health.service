[Unit]
Description=Rainbow Fashions backup health and alert check
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=RAINBOW_APP_ROOT=/opt/rainbow-fashions-prod
Environment=RAINBOW_COMPOSE_PROJECT=rainbow_prod
ExecStart=/opt/rainbow-fashions-prod/current/deployment/scripts/check_backup_health.sh
