# Copy this file to /opt/rainbow-fashions/shared/backup-offsite.env on the
# production server, replace every CHANGE_ME value, then run chmod 600 on it.
# Choose one provider configuration only. This template is for S3-compatible
# object storage; do not add SFTP credentials to this file.
BACKUP_PROVIDER=s3
RESTIC_REPOSITORY=s3:https://OBJECT_STORAGE_ENDPOINT/BUCKET/rainbow-fashions
RESTIC_PASSWORD=CHANGE_ME_STRONG_RESTIC_PASSWORD
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=CHANGE_ME

# Run a repository integrity check at least every seven days.
RESTIC_CHECK_INTERVAL_DAYS=7
