# Copy this template to /opt/rainbow-fashions/shared/backend.env on the server.
# Replace every CHANGE_ME value before deployment. Never commit the real file.
APP_NAME="Rainbow Fashions Inventory"
APP_ENV=production
DEBUG=false

POSTGRES_DB=inventory_db
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

DATABASE_URL=postgresql+psycopg://inventory_user:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/inventory_db

JWT_SECRET_KEY=CHANGE_ME_OUTPUT_OF_OPENSSL_RAND_HEX_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=https://test.rainbow-fashions.in

UPLOAD_DIR=app/uploads
INVOICE_UPLOAD_DIR=app/uploads/invoices
PRODUCT_UPLOAD_DIR=app/uploads/products
MAX_UPLOAD_SIZE_MB=15
LOG_LEVEL=INFO

# OCR and document-processing settings
OCR_PROVIDER=local
DOCUMENT_AI_PROVIDER=mock
DOCUMENT_AI_FALLBACK_PROVIDER=mock
DOCUMENT_AI_TIMEOUT_SECONDS=90
DOCUMENT_AI_MAX_RETRIES=2
DOCUMENT_RETENTION_DAYS=365
FAILED_UPLOAD_RETENTION_DAYS=7
