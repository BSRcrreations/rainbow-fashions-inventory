# Copy to /opt/rainbow-fashions-prod/shared/availability-alerts.env and chmod 600.
# Do not commit the real file.

APP_ENVIRONMENT=production

# Generic, Slack-compatible, or Teams-compatible incoming webhook URL.
# Leave blank to disable webhook alerts.
AVAILABILITY_WEBHOOK_URL=

# SMTP fields are reserved for deployments that wire an SMTP sender wrapper.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
