# Copy to /etc/rainbow-fashions/backup.env on the STAGING host first, set 0600,
# validate there, then deploy the reviewed configuration to production. Never
# commit the real file. PostgreSQL reads its password from PGPASSFILE (0600).
BACKUP_DB_HOST=127.0.0.1
BACKUP_DB_PORT=5432
BACKUP_DB_NAME=rainbow_inventory
BACKUP_DB_USER=rainbow_backup
PGPASSFILE=/etc/rainbow-fashions/pgpass

BACKUP_LOCAL_PATH=/u02/backups
BACKUP_RETENTION_DAYS=30

# All directories are archived relative to this root, preserving the upload
# tree and file timestamps. APPLICATION_UPLOAD_PATH includes every child
# directory (recommended); use the individual paths only when needed.
UPLOAD_ARCHIVE_ROOT=/u02/rainbow/uploads
APPLICATION_UPLOAD_PATH=/u02/rainbow/uploads
PRODUCT_IMAGE_PATH=/u02/rainbow/uploads/products
BRAND_IMAGE_PATH=/u02/rainbow/uploads/brands
INVOICE_UPLOAD_PATH=/u02/rainbow/uploads/invoices
OCR_UPLOAD_PATH=/u02/rainbow/uploads/ocr
SUPPLIER_DOCUMENT_PATH=/u02/rainbow/uploads/suppliers
# Colon-separated paths inside UPLOAD_ARCHIVE_ROOT, for example:
ADDITIONAL_UPLOAD_PATHS=

# Encrypted remote storage. Use a scoped credential in this protected file.
RESTIC_REPOSITORY=s3:https://OBJECT_STORAGE_ENDPOINT/BUCKET/rainbow-fashions
RESTIC_PASSWORD=CHANGE_ME_UNIQUE_STRONG_RESTIC_PASSWORD
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=CHANGE_ME

# Disk warning/critical alerts. Leave the webhook blank only if the host-level
# monitoring system independently alerts on a non-zero monitor service result.
BACKUP_DISK_WARNING_PERCENT=80
BACKUP_DISK_CRITICAL_PERCENT=90
BACKUP_ALERT_WEBHOOK_URL=

# Weekly restore drill, only on staging. This database must be dedicated and
# disposable. Give its role only permissions on this database.
RESTORE_TEST_ENVIRONMENT=staging
RESTORE_TEST_DB_HOST=127.0.0.1
RESTORE_TEST_DB_PORT=5432
RESTORE_TEST_DB_NAME=rainbow_inventory_restore_test
RESTORE_TEST_DB_USER=rainbow_restore_test
